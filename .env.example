# Backend
# Taalmodel: ollama (lokaal) of azure_openai (zoals in Azure)
LLM_PROVIDER=ollama
DATABASE_URL=postgresql+asyncpg://finkennis:finkennis@localhost:5433/finkennis
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
INGEST_CONCURRENCY=1
CORS_ORIGINS=["http://localhost:5190"]

# Alleen bij LLM_PROVIDER=azure_openai. EMBED_DIM blijft 768: text-embedding-3-large levert
# dan vectoren van 768 dimensies, passend op het schema.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-5.3-chat
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_EMBEDDING_API_KEY=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Authenticatie: none (lokaal, één dev-gebruiker) of oidc (Keycloak)
AUTH_MODE=none
OIDC_ISSUER=http://localhost:8180/realms/finkennis
OIDC_AUDIENCE=finkennis-api
# Service account voor gebruikersbeheer (Keycloak Admin REST API)
OIDC_ADMIN_CLIENT_ID=finkennis-admin
OIDC_ADMIN_CLIENT_SECRET=dev-admin-secret-change-me

# Frontend (Vite leest VITE_*-variabelen uit frontend/.env)
# VITE_AUTH_MODE=oidc
# VITE_OIDC_AUTHORITY=http://localhost:8180/realms/finkennis
# VITE_OIDC_CLIENT_ID=finkennis-frontend
